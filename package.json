{
  "name": "c1-sinistros",
  "version": "0.1.0",
  "private": true,
  "description": "C1 · Registro e investigação de sinistros (INFLEET) — ambiente local",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "start": "tsx server/index.ts --prod",
    "db:reset": "tsx server/reset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test server/*.test.ts",
    "predev": "node scripts/check-node.mjs",
    "prestart": "node scripts/check-node.mjs",
    "build:demo": "vite build --mode demo && node scripts/artifact-demo.mjs"
  },
  "dependencies": {
    "express": "^4.22.3",
    "multer": "^2.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "sql.js": "^1.14.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.1",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
